@startuml
title PetLink V1.0 完整用例清单图
left to right direction

skinparam packageStyle rectangle
skinparam shadowing false

actor "未登录访客\nVISITOR" as Visitor
actor "普通用户\nUSER" as User
actor "救助人员\nRESCUER" as Rescuer
actor "系统管理员\nADMIN" as Admin

rectangle "PetLink 流浪动物救助与领养服务平台" {
    package "用户与认证" {
        usecase "注册" as F_Register
        usecase "登录" as F_Login
        usecase "维护个人资料" as F_Profile
    }

    package "动物浏览与收藏" {
        usecase "浏览动物" as F_BrowseAnimal
        usecase "筛选动物" as F_FilterAnimal
        usecase "查看动物详情" as F_AnimalDetail
        usecase "收藏动物" as F_Favorite
        usecase "取消收藏" as F_Unfavorite
        usecase "查看本人收藏列表" as F_ViewFavorites
    }

    package "救助线索管理" {
        usecase "发布救助线索\nUC-01" as F_PublishClue
        usecase "查看本人救助线索" as F_ViewOwnClue
        usecase "修改待审核线索" as F_EditClue
        usecase "撤回待审核线索" as F_WithdrawClue
        usecase "审核救助线索\nUC-02" as F_AuditClue
    }

    package "救助任务管理" {
        usecase "查看待接取线索" as F_ViewWaiting
        usecase "接取救助任务\nUC-03" as F_AcceptTask
        usecase "更新并完成救助任务\nUC-04" as F_UpdateTask
        usecase "填写救助记录" as F_RescueRecord
        usecase "查看 / 管理救助任务" as F_ManageTask
        usecase "处理异常任务" as F_HandleAbnormal
    }

    package "动物档案管理" {
        usecase "创建动物档案" as F_CreateAnimal
        usecase "维护动物档案" as F_EditAnimal
        usecase "添加健康记录" as F_AddHealth
        usecase "查看健康记录" as F_ViewHealth
        usecase "管理动物图片" as F_ManageAnimalImage
    }

    package "领养管理" {
        usecase "提交领养申请\nUC-05" as F_ApplyAdoption
        usecase "撤回本人待审核申请" as F_WithdrawApplication
        usecase "查看本人领养申请及状态" as F_ViewApplication
        usecase "审核领养申请\nUC-06" as F_AuditAdoption
        usecase "查看本人领养记录" as F_ViewOwnAdoption
        usecase "管理领养记录" as F_ManageAdoption
        usecase "查看负责动物的\n领养情况" as F_ViewResponsibleAdoption
    }

    package "领养回访" {
        usecase "提交领养回访\nUC-07" as F_SubmitFollowUp
        usecase "查看本人回访" as F_ViewOwnFollowUp
        usecase "查看负责动物的回访" as F_ViewResponsibleFollowUp
        usecase "查看全部回访" as F_AdminFollowUp
    }

    package "公告与后台管理" {
        usecase "查看公告" as F_ViewNotice
        usecase "公告管理" as F_ManageNotice
        usecase "用户管理" as F_UserManage
        usecase "救助人员管理" as F_RescuerManage
        usecase "数据统计" as F_Statistics
    }
}

Visitor -- F_Register
Visitor -- F_BrowseAnimal
Visitor -- F_FilterAnimal
Visitor -- F_AnimalDetail
Visitor -- F_ViewNotice

User -- F_Login
User -- F_Profile
User -- F_BrowseAnimal
User -- F_FilterAnimal
User -- F_AnimalDetail
User -- F_Favorite
User -- F_Unfavorite
User -- F_ViewFavorites
User -- F_PublishClue
User -- F_ViewOwnClue
User -- F_EditClue
User -- F_WithdrawClue
User -- F_ApplyAdoption
User -- F_WithdrawApplication
User -- F_ViewApplication
User -- F_ViewOwnAdoption
User -- F_SubmitFollowUp
User -- F_ViewOwnFollowUp
User -- F_ViewNotice

Rescuer -- F_Login
Rescuer -- F_Profile
Rescuer -- F_BrowseAnimal
Rescuer -- F_FilterAnimal
Rescuer -- F_AnimalDetail
Rescuer -- F_Favorite
Rescuer -- F_Unfavorite
Rescuer -- F_ViewFavorites
Rescuer -- F_PublishClue
Rescuer -- F_ViewOwnClue
Rescuer -- F_EditClue
Rescuer -- F_WithdrawClue
Rescuer -- F_ViewWaiting
Rescuer -- F_AcceptTask
Rescuer -- F_UpdateTask
Rescuer -- F_RescueRecord
Rescuer -- F_CreateAnimal
Rescuer -- F_EditAnimal
Rescuer -- F_AddHealth
Rescuer -- F_ViewHealth
Rescuer -- F_ManageAnimalImage
Rescuer -- F_ApplyAdoption
Rescuer -- F_WithdrawApplication
Rescuer -- F_ViewApplication
Rescuer -- F_ViewOwnAdoption
Rescuer -- F_ViewResponsibleAdoption
Rescuer -- F_SubmitFollowUp
Rescuer -- F_ViewOwnFollowUp
Rescuer -- F_ViewResponsibleFollowUp
Rescuer -- F_ViewNotice

Admin -- F_Login
Admin -- F_Profile
Admin -- F_BrowseAnimal
Admin -- F_FilterAnimal
Admin -- F_AnimalDetail
Admin -- F_AuditClue
Admin -- F_ManageTask
Admin -- F_HandleAbnormal
Admin -- F_CreateAnimal
Admin -- F_EditAnimal
Admin -- F_AddHealth
Admin -- F_ViewHealth
Admin -- F_ManageAnimalImage
Admin -- F_AuditAdoption
Admin -- F_ManageAdoption
Admin -- F_AdminFollowUp
Admin -- F_ViewNotice
Admin -- F_ManageNotice
Admin -- F_UserManage
Admin -- F_RescuerManage
Admin -- F_Statistics

@enduml
