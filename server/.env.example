SPRING_PROFILES_ACTIVE=dev
PETLINK_DB_URL=jdbc:mysql://127.0.0.1:3306/petlink?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
PETLINK_DB_USER=root
PETLINK_DB_PASSWORD=your_mysql_password
PETLINK_JWT_SECRET=replace_with_at_least_32_utf8_bytes_secret
PETLINK_JWT_EXPIRES_IN_SECONDS=7200
PETLINK_FILE_ROOT=./data/uploads
PETLINK_TEMPORARY_TTL=PT1H
PETLINK_FILE_CLEANUP_INTERVAL_MS=3600000
PETLINK_CORS_ORIGIN_PC=http://localhost:5173
PETLINK_CORS_ORIGIN_PC_IP=http://127.0.0.1:5173
PETLINK_CORS_ORIGIN_BUNDLED=http://localhost:8081
PETLINK_CORS_ORIGIN_BUNDLED_IP=http://127.0.0.1:8081

# M02 short idempotency cache
PETLINK_CLUE_IDEMPOTENCY_TTL=PT10M
PETLINK_CLUE_IDEMPOTENCY_CLEANUP_INTERVAL_MS=60000
