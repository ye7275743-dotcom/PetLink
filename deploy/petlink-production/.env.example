# Copy to .env on the server and chmod 600. Never commit the filled file.
PETLINK_WEB_PORT=8081
PETLINK_PUBLIC_ORIGIN=http://103.233.254.186:8081
PETLINK_DB_NAME=petlink
PETLINK_DB_USER=petlink_app
PETLINK_DB_PASSWORD=replace-with-a-long-random-password
PETLINK_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
PETLINK_JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
PETLINK_TEMPORARY_TTL=PT1H
PETLINK_FILE_CLEANUP_INTERVAL_MS=3600000
PETLINK_CLUE_IDEMPOTENCY_TTL=PT10M
PETLINK_CLUE_IDEMPOTENCY_CLEANUP_INTERVAL_MS=60000
